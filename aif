#!/usr/bin/env bash
# aif -- cartório do loop manual orquestrador <-> Reasonix.
#
# Não roda modelo nenhum. Cuida do git, valida os artefatos que os agentes
# escrevem e diz qual é o próximo passo. Convenções idênticas às do ai-flow:
# branch ai/<slug>, worktree ../.ai-flow-worktrees/<projeto>/<slug>, artefatos
# em .ai/.
#
# O orquestrador (quem planeja e revisa) pode ser o Claude Code ou o OpenCode:
# os dois leem o mesmo prompt, cada um do seu diretório. Veja AIF_ORCHESTRATOR.
#
#   aif install <projeto>    copia o pacote para um projeto, sem sobrescrever
#   aif open "<descrição>"   cria branch + worktree + esqueleto do contrato
#   aif cd                   imprime o caminho da worktree (use: cd "$(aif cd)")
#   aif status               o semáforo: onde estamos e qual o próximo passo
#   aif verify               valida .ai/review.json sem commitar
#   aif accept               valida e commita o trabalho aprovado
#   aif land                 mescla na base, remove a worktree e apaga a branch
#   aif drop                 remove a worktree e a branch da tarefa
#   aif version              imprime a versão deste script
#
# Configuráveis por ambiente:
#   AIF_BRANCH_PREFIX  (padrão: ai)
#   AIF_WORKTREE_DIR   (padrão: ../.ai-flow-worktrees)
#   AIF_COMMIT_PREFIX  (padrão: feat)
#   AIF_ORCHESTRATOR   (padrão: claude — ou opencode)

set -euo pipefail

# Versão do pacote inteiro (script + prompts + settings), não só do aif:
# eles evoluem juntos e um contrato novo costuma exigir validação nova.
# Semântica: MAJOR quebra o fluxo ou o formato dos artefatos em .ai/,
# MINOR acrescenta comando ou campo, PATCH corrige comportamento.
# O histórico legível fica no CHANGELOG.md, ao lado deste arquivo.
AIF_VERSION="1.0.2"

BRANCH_PREFIX="${AIF_BRANCH_PREFIX:-ai}"
WORKTREE_DIR="${AIF_WORKTREE_DIR:-../.ai-flow-worktrees}"
COMMIT_PREFIX="${AIF_COMMIT_PREFIX:-feat}"
MAX_SLUG=60

# Só muda o que o aif imprime: qual GUI ele manda você abrir e com que nome a
# chama. Nada da validação depende disso — os dois orquestradores escrevem os
# mesmos .ai/current-task.md e .ai/review.json.
case "${AIF_ORCHESTRATOR:-claude}" in
  claude)   ORCH_NAME="Claude Code"; ORCH_CMD="claude" ;;
  opencode) ORCH_NAME="OpenCode";    ORCH_CMD="opencode" ;;
  *)        ORCH_NAME="${AIF_ORCHESTRATOR}"; ORCH_CMD="${AIF_ORCHESTRATOR}" ;;
esac

bold=$'\033[1m'; dim=$'\033[2m'; red=$'\033[31m'; grn=$'\033[32m'
ylw=$'\033[33m'; cyn=$'\033[36m'; rst=$'\033[0m'
[ -t 1 ] || { bold=""; dim=""; red=""; grn=""; ylw=""; cyn=""; rst=""; }

die() { printf '%saif: %s%s\n' "$red" "$*" "$rst" >&2; exit 1; }

# Sempre a worktree principal, mesmo quando chamado de dentro de uma worktree de
# tarefa: --show-toplevel devolveria a worktree, e o estado (.aif/) mora só no
# repositório principal. A primeira linha de `worktree list` é sempre a main.
repo_root() {
  git rev-parse --git-dir >/dev/null 2>&1 || die "não estou dentro de um repositório git"
  local line; line="$(git worktree list --porcelain | head -1)"
  printf '%s' "${line#worktree }"
}

# Remover uma worktree debaixo dos próprios pés deixa o shell num diretório que
# não existe mais. Melhor recusar.
refuse_if_inside() {
  case "$PWD/" in
    "$1"/*) die "você está dentro da worktree que seria removida.
    Volte para o repositório primeiro:  cd \"$(repo_root)\"" ;;
  esac
}

# Em python3, e não no pipeline iconv+sed de antes, porque aquele dava slugs
# diferentes conforme o locale e conforme a implementação do iconv — o do macOS
# não é o do glibc. Com LC_ALL=C, "Ação" virava "a-o" em vez de "acao", e o
# nome da branch passava a depender do ambiente de quem rodou. O python3 já é
# dependência do resto do script e normaliza igual nos dois sistemas.
make_slug() {
  local s
  s="$(python3 - "$1" "$MAX_SLUG" <<'PY'
import re, sys, unicodedata
text, limit = sys.argv[1], int(sys.argv[2])
plain = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
print(re.sub(r"[^a-z0-9]+", "-", plain.lower()).strip("-")[:limit].rstrip("-"))
PY
)"
  [ -n "$s" ] || die "descrição não gera um slug válido"
  printf '%s' "$s"
}

state_file() { printf '%s/.aif/current.json' "$(repo_root)"; }

read_state() {
  local f; f="$(state_file)"
  [ -f "$f" ] || die "nenhuma tarefa ativa. Comece com: aif open \"<descrição>\""
  SLUG="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["slug"])' "$f")"
  BRANCH="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["branch"])' "$f")"
  WORKTREE="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["worktree"])' "$f")"
  DESCRIPTION="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["description"])' "$f")"
  # Estados antigos não têm estes campos; o .get mantém a compatibilidade.
  BASE="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("base_branch") or "")' "$f")"
  ACCEPTED="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("accepted") or "")' "$f")"
  [ -n "$BASE" ] || BASE="$(base_branch)"
  [ -d "$WORKTREE" ] || die "a worktree sumiu: $WORKTREE"
}

# Marca a tarefa como commitada e à espera de integração.
mark_accepted() {
  python3 - "$(state_file)" "$1" <<'PY'
import json, sys
f, sha = sys.argv[1:3]
d = json.load(open(f, encoding="utf-8"))
d["accepted"] = sha
with open(f, "w", encoding="utf-8") as out:
    json.dump(d, out, ensure_ascii=False, indent=2)
PY
}

# ---------------------------------------------------------------- validadores

plan_state() {  # ok | missing | invalid:<motivo>
  local plan="$WORKTREE/.ai/current-task.md"
  [ -f "$plan" ] || { echo "missing"; return; }
  python3 - "$plan" <<'PY'
import re, sys
text = open(sys.argv[1], encoding="utf-8").read()
body = re.sub(r"<[^>\n]{0,80}>", "", text).strip()
if len(body) < 80:
    print("invalid:conteúdo insuficiente (mínimo 80 caracteres reais)"); sys.exit()
missing = [s for s in ("Plan", "Acceptance criteria")
           if not re.search(rf"^#{{1,3}}\s*{re.escape(s)}\b", text, re.I | re.M)]
print("invalid:faltam as seções " + ", ".join(missing) if missing else "ok")
PY
}

review_state() {  # missing | invalid:<motivo> | approved:<n_low> | changes:<n_bloq>
  local rev="$WORKTREE/.ai/review.json"
  [ -f "$rev" ] || { echo "missing"; return; }
  python3 - "$rev" <<'PY'
import json, sys
BLOCKING = {"CRITICAL", "HIGH", "MEDIUM"}
SEV = BLOCKING | {"LOW"}
try:
    d = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception as e:
    print(f"invalid:JSON inválido ({e})"); sys.exit()
if not isinstance(d, dict):
    print("invalid:a raiz não é um objeto"); sys.exit()
status = d.get("status")
if status not in ("approved", "changes_required"):
    print(f"invalid:status {status!r} (esperado approved ou changes_required)"); sys.exit()
if not str(d.get("summary", "")).strip():
    print("invalid:summary vazio"); sys.exit()
issues = d.get("issues", [])
if not isinstance(issues, list):
    print("invalid:issues não é lista"); sys.exit()
for i, it in enumerate(issues):
    if not isinstance(it, dict):
        print(f"invalid:issue {i} não é objeto"); sys.exit()
    faltam = [k for k in ("severity", "file", "description", "recommendation")
              if not str(it.get(k, "")).strip()]
    if faltam:
        print(f"invalid:issue {i} sem {', '.join(faltam)}"); sys.exit()
    if it["severity"] not in SEV:
        print(f"invalid:issue {i} com severity {it['severity']!r}"); sys.exit()
bloq = [it for it in issues if it["severity"] in BLOCKING]
low = len(issues) - len(bloq)
if bloq:
    # aprovado com bloqueante é contradição: vale o mais seguro.
    print(f"changes:{len(bloq)}")
else:
    print(f"approved:{low}" if status == "approved" else "changes:0")
PY
}

has_code_changes() {
  local n
  n="$(git -C "$WORKTREE" status --porcelain -- . ':(exclude).ai' | wc -l)"
  local c
  c="$(git -C "$WORKTREE" diff --name-only "$(base_branch)...HEAD" -- . ':(exclude).ai' 2>/dev/null | wc -l || echo 0)"
  [ "$n" -gt 0 ] || [ "$c" -gt 0 ]
}

base_branch() {
  local root b
  root="$(repo_root)"
  b="$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  b="${b#origin/}"
  if [ -z "$b" ]; then
    if git -C "$root" show-ref --quiet refs/heads/main; then b=main; else b=master; fi
  fi
  printf '%s' "$b"
}

# -------------------------------------------------------------------- comandos

cmd_install() {
  local src="" dest=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --from) src="${2:-}"; [ -n "$src" ] || die "--from exige um caminho"; shift 2 ;;
      -*)     die "opção desconhecida: $1" ;;
      *)      [ -z "$dest" ] || die "só um projeto por vez"; dest="$1"; shift ;;
    esac
  done
  [ -n "$dest" ] || die "uso: aif install <caminho/do/projeto> [--from <raiz do pacote>]"
  [ -d "$dest" ] || die "o destino não existe: $dest"
  dest="$(cd "$dest" && pwd)"

  # Sem --from, o pacote é o diretório atual. O aif instalado vive em
  # ~/.local/bin, longe dos arquivos, então $0 não serve de pista.
  src="${src:-$PWD}"
  [ -d "$src" ] || die "a origem não existe: $src"
  src="$(cd "$src" && pwd)"
  local f
  for f in .claude/commands/planejar.md .claude/commands/revisar.md \
           .claude/settings.json .ai/implementer.md REASONIX.md \
           .opencode/agents/planejador.md .opencode/agents/revisor.md \
           .opencode/commands/planejar.md .opencode/commands/revisar.md; do
    [ -f "$src/$f" ] || die "$src não parece a raiz do pacote (falta $f). Use --from."
  done
  [ "$src" != "$dest" ] || die "origem e destino são o mesmo diretório"

  git -C "$dest" rev-parse --show-toplevel >/dev/null 2>&1 \
    || printf '%s! o destino não é um repositório git — o loop precisa de um%s\n\n' "$ylw" "$rst"

  printf '\n%sinstalando em%s %s %s(aif %s)%s\n\n' \
    "$bold" "$rst" "$dest" "$dim" "$AIF_VERSION" "$rst"
  mkdir -p "$dest/.claude/commands" "$dest/.ai" \
           "$dest/.opencode/commands" "$dest/.opencode/agents"

  # Nada aqui sobrescreve: quem já existe no destino ganha. Um settings.json
  # do projeto vale mais que o do pacote, e o mesmo vale para um REASONIX.md
  # que você já ajustou.
  local kept=0
  copy_keep() {
    if [ -e "$dest/$2" ]; then
      printf '  %s—%s %-32s já existe, mantido\n' "$ylw" "$rst" "$2"
      kept=$((kept + 1))
    else
      cp "$src/$1" "$dest/$2"
      printf '  %s✓%s %-32s copiado\n' "$grn" "$rst" "$2"
    fi
  }
  # O prompt de cada papel é um arquivo só, em .claude/commands/, e o OpenCode
  # o alcança por symlink relativo. Os dois leem diretórios diferentes e nenhum
  # lê o do outro, mas o frontmatter carrega os campos dos dois — cada um ignora
  # o que não conhece —, então duplicar o corpo só criaria divergência.
  # Se o link não puder ser criado (sistema de arquivos sem symlink), cai para
  # cópia: dois arquivos que funcionam valem mais que um link quebrado.
  link_keep() {
    # Link pendurado: alguém apagou o .claude/. Não recrio nem sobrescrevo —
    # um 'cp' aqui escreveria *através* do link e ressuscitaria o arquivo que
    # a pessoa acabou de apagar. Só aviso.
    if [ -L "$dest/$2" ] && [ ! -e "$dest/$2" ]; then
      printf '  %s!%s %-32s symlink quebrado (alvo %s sumiu)\n' \
        "$ylw" "$rst" "$2" "$1"
      kept=$((kept + 1))
    elif [ -e "$dest/$2" ]; then
      printf '  %s—%s %-32s já existe, mantido\n' "$ylw" "$rst" "$2"
      kept=$((kept + 1))
    elif ln -s "$1" "$dest/$2" 2>/dev/null; then
      printf '  %s✓%s %-32s %s→ %s%s\n' "$grn" "$rst" "$2" "$dim" "$1" "$rst"
    else
      cp "$src/$3" "$dest/$2"
      printf '  %s✓%s %-32s copiado %s(symlink indisponível)%s\n' \
        "$grn" "$rst" "$2" "$dim" "$rst"
    fi
  }

  copy_keep .claude/commands/planejar.md .claude/commands/planejar.md
  copy_keep .claude/commands/revisar.md  .claude/commands/revisar.md
  copy_keep .ai/implementer.md           .ai/implementer.md
  copy_keep REASONIX.md                  REASONIX.md
  copy_keep .opencode/agents/planejador.md .opencode/agents/planejador.md
  copy_keep .opencode/agents/revisor.md    .opencode/agents/revisor.md
  link_keep ../../.claude/commands/planejar.md .opencode/commands/planejar.md \
            .claude/commands/planejar.md
  link_keep ../../.claude/commands/revisar.md  .opencode/commands/revisar.md \
            .claude/commands/revisar.md

  install_settings
  printf '\n'

  if [ "$kept" -gt 0 ]; then
    printf '%s%s arquivo(s) já existiam e ficaram como estavam.%s\n' \
      "$dim" "$kept" "$rst"
    printf '%sCompare com o pacote se quiser as versões novas:%s\n' "$dim" "$rst"
    printf '%s  diff -ru "%s" "%s" | less%s\n\n' "$dim" "$src" "$dest" "$rst"
  fi

  printf '%sFalta você:%s\n\n' "$bold" "$rst"
  printf '  1. ajustar o comando de testes na última seção de %sREASONIX.md%s\n' "$bold" "$rst"
  printf '     (roda da raiz, termina sozinho, código de saída confiável)\n'
  printf '  2. commitar — a worktree só enxerga o que está commitado:\n\n'
  printf '     cd "%s"\n' "$dest"
  printf '     git add REASONIX.md .ai .claude .opencode && git status --short\n\n'
  printf '  3. desabilitar as skills de review do Reasonix — ele não tem o plano\n'
  printf '     nem o contrato, e duplica o que o /revisar já faz com os dois em mãos:\n\n'
  printf '     %s~/.reasonix/config.toml%s → [skills] disabled_skills = ["review",\n' \
    "$bold" "$rst"
  printf '     "review-bugbot", "review-security", "security-review"]\n\n'
  printf '  %sO .opencode/ é inerte se você só usa o Claude Code — e vice-versa.%s\n' \
    "$dim" "$rst"
  printf '  %sPara o aif falar do OpenCode: export AIF_ORCHESTRATOR=opencode%s\n\n' \
    "$dim" "$rst"
}

# Onde a statusline e os hooks do pacote já estão, se é que estão. O Claude Code
# soma o settings.json com o settings.local.json, então os dois contam como um
# só: instalar de novo no outro arquivo não sobrescreve nada — duplica, e o
# hook dispara duas vezes. Por isso a checagem é sobre conteúdo, não sobre
# arquivo existir.
settings_scan() {
  python3 - "$@" <<'PY'
import json, os, sys
pkg = json.load(open(sys.argv[1], encoding="utf-8"))

loaded = []
for p in sys.argv[2:]:
    if not os.path.exists(p):
        continue
    try:
        d = json.load(open(p, encoding="utf-8"))
    except Exception:
        continue                      # inválido: o merge vai reclamar depois
    if isinstance(d, dict):
        loaded.append((os.path.basename(p), d))

def key(o): return json.dumps(o, sort_keys=True, ensure_ascii=False)

found, missing = [], []
if "statusLine" in pkg:
    hits = [n for n, d in loaded if "statusLine" in d]
    found += hits or []
    if not hits: missing.append("statusline")
for event, blocks in pkg.get("hooks", {}).items():
    for b in blocks:
        hits = [n for n, d in loaded
                if any(key(c) == key(b)
                       for c in (d.get("hooks") or {}).get(event, []))]
        found += hits or []
        if not hits: missing.append(f"hook {event}")

onde = ", ".join(sorted(set(found)))
if not missing:
    print("installed:" + onde)
elif found:
    print("partial:falta " + ", ".join(sorted(set(missing))) + "; o resto já está em " + onde)
else:
    print("absent:")
PY
}

# O settings.json é o único arquivo que costuma disputar espaço com algo que já
# existe, e sobrescrevê-lo apaga as permissões do projeto em silêncio. Então
# ele não entra na cópia cega: ou não há conflito, ou você decide.
install_settings() {
  local pkg="$src/.claude/settings.json"
  local tgt="$dest/.claude/settings.json"
  local loc="$dest/.claude/settings.local.json"
  local label=".claude/settings.json"

  local scan; scan="$(settings_scan "$pkg" "$tgt" "$loc")"
  if [ "${scan%%:*}" = "installed" ]; then
    printf '  %s✓%s %-32s já instalado em %s\n' "$grn" "$rst" "$label" "${scan#installed:}"
    return
  fi

  if [ ! -e "$tgt" ]; then
    cp "$pkg" "$tgt"
    printf '  %s✓%s %-32s copiado\n' "$grn" "$rst" "$label"
    return
  fi

  printf '  %s!%s %-32s já existe\n\n' "$ylw" "$rst" "$label"
  printf '    O projeto tem um settings.json próprio. Copiar por cima apagaria\n'
  printf '    as permissões dele. Onde entram a statusline e os hooks?\n'
  [ "${scan%%:*}" = "partial" ] \
    && printf '    %s(%s)%s\n' "$dim" "${scan#partial:}" "$rst"
  printf '\n'
  printf '      %s1%s  .claude/settings.local.json  (não versionado — recomendado)\n' "$bold" "$rst"
  printf '      %s2%s  .claude/settings.json        (mescla no que já está lá)\n' "$bold" "$rst"
  printf '      %s3%s  pular                        (resolvo à mão depois)\n\n' "$bold" "$rst"
  printf '    escolha [1/2/3]: '
  local a; read -r a
  local out
  case "$a" in
    1|"") out="$loc" ;;
    2)    out="$tgt" ;;
    *)    printf '\n  %s—%s statusline e hooks não foram instalados\n' "$ylw" "$rst"; return ;;
  esac

  local res
  res="$(merge_settings "$pkg" "$out")" || die "falhou ao mesclar: ${res#ERRO:}"
  printf '\n  %s✓%s %s: %s\n' "$grn" "$rst" "${out#$dest/}" "${res#OK:}"

  if [ "$out" = "$loc" ]; then
    grep -qs 'settings\.local\.json' "$dest/.gitignore" 2>/dev/null \
      || { echo '.claude/settings.local.json' >> "$dest/.gitignore"
           printf '  %s✓%s .gitignore: settings.local.json ignorado\n' "$grn" "$rst"; }
  fi
}

# Mescla só o que falta. Nunca remove chave, nunca troca valor que já existe,
# e rodar duas vezes não duplica hook.
merge_settings() {
  python3 - "$1" "$2" <<'PY'
import json, os, sys
src = json.load(open(sys.argv[1], encoding="utf-8"))
path = sys.argv[2]
dst = {}
if os.path.exists(path):
    try:
        dst = json.load(open(path, encoding="utf-8"))
    except Exception as e:
        print(f"ERRO:{os.path.basename(path)} não é JSON válido ({e})"); sys.exit(1)
    if not isinstance(dst, dict):
        print(f"ERRO:{os.path.basename(path)} não tem um objeto na raiz"); sys.exit(1)

notes = []
if "statusLine" in src:
    if "statusLine" not in dst:
        dst["statusLine"] = src["statusLine"]; notes.append("statusline adicionada")
    elif dst["statusLine"] != src["statusLine"]:
        notes.append("statusline própria mantida")

def key(o): return json.dumps(o, sort_keys=True, ensure_ascii=False)

src_hooks = src.get("hooks", {})
if src_hooks:
    dst_hooks = dst.get("hooks")
    if not isinstance(dst_hooks, dict):
        dst_hooks = {}
    added = []
    for event, blocks in src_hooks.items():
        cur = dst_hooks.setdefault(event, [])
        seen = {key(c) for c in cur}
        for b in blocks:
            if key(b) not in seen:
                cur.append(b); added.append(event)
    dst["hooks"] = dst_hooks
    notes.append("hooks " + ", ".join(sorted(set(added))) + " adicionados" if added
                 else "hooks já presentes")

with open(path, "w", encoding="utf-8") as f:
    json.dump(dst, f, ensure_ascii=False, indent=2); f.write("\n")
print("OK:" + ("; ".join(notes) if notes else "nada a fazer"))
PY
}

# O 'git worktree add' materializa a branch base, então a worktree recebe só o
# que está commitado nela. Arquivo do pacote que ficou de fora simplesmente não
# existe lá dentro, e o sintoma aparece longe da causa: o orquestrador abre e
# não encontra o /planejar. Aviso antes de criar, porque depois o conserto é
# refazer a tarefa.
#
# O .ai/implementer.md e o .ai/decisions.md não entram na checagem: esses o
# 'open' copia à mão para dentro da worktree logo abaixo, e por isso sobrevivem
# sem commit.
warn_uncommitted_package() {
  local root="$1" base="$2" p faltando=""
  for p in .claude/commands .opencode REASONIX.md; do
    [ -e "$root/$p" ] || continue
    if [ -z "$(git -C "$root" ls-tree -r --name-only "$base" -- "$p" 2>/dev/null)" ]; then
      faltando="$faltando
    $p — não está commitado em $base"
    elif [ -n "$(git -C "$root" status --porcelain -- "$p" 2>/dev/null)" ]; then
      faltando="$faltando
    $p — tem alterações não commitadas"
    fi
  done
  [ -n "$faltando" ] || return 0

  printf '\n%s!  a worktree vai nascer sem isto:%s%s\n\n' "$ylw" "$rst" "$faltando"
  printf '   A worktree é um checkout de %s: o que não está commitado lá não\n' "$base"
  printf '   aparece dentro dela, e o orquestrador abre sem os comandos.\n\n'
  printf '   Cancele com Ctrl-C, commite, e rode o open de novo:\n\n'
  printf '     %sgit -C "%s" add .claude .opencode REASONIX.md && git -C "%s" commit%s\n\n' \
    "$bold" "$root" "$root" "$rst"
  printf '   continuar assim mesmo? [s/N] '
  local a; read -r a
  case "$a" in s|S|y|Y) printf '\n' ;; *) die "cancelado; nada foi criado" ;; esac
}

cmd_open() {
  [ $# -ge 1 ] && [ -n "${1:-}" ] || die "uso: aif open \"<descrição da tarefa>\""
  local root; root="$(repo_root)"
  git -C "$root" rev-parse HEAD >/dev/null 2>&1 \
    || die "o repositório não tem commits ainda; faça o commit inicial primeiro"
  if [ -f "$(state_file)" ]; then
    read_state
    [ -n "$ACCEPTED" ] \
      && die "a tarefa '$SLUG' foi aceita mas não integrada. Integre com 'aif land' ou descarte com 'aif drop'."
    die "a tarefa '$SLUG' ainda está ativa. Finalize com 'aif accept' ou descarte com 'aif drop'."
  fi
  local desc="$1" slug branch base wt
  slug="$(make_slug "$desc")"
  branch="$BRANCH_PREFIX/$slug"
  base="$(base_branch)"
  # Namespace por projeto. Sem ele, todo repositório que divide o mesmo
  # diretório-pai divide também o .ai-flow-worktrees/, e duas tarefas com a
  # mesma descrição em projetos irmãos disputam o mesmo caminho.
  local proj; proj="$(basename "$root")"
  wt="$(cd "$root" && mkdir -p "$WORKTREE_DIR/$proj" && cd "$WORKTREE_DIR/$proj" && pwd)/$slug"

  git -C "$root" show-ref --quiet "refs/heads/$branch" \
    && die "a branch $branch já existe"
  # git worktree add cria a branch e só depois tropeça num caminho ocupado,
  # deixando uma branch órfã para trás. Melhor descobrir antes.
  [ -e "$wt" ] && die "já existe algo em $wt — remova ou use outra descrição"
  warn_uncommitted_package "$root" "$base"
  git -C "$root" worktree add -b "$branch" "$wt" "$base" >/dev/null
  mkdir -p "$wt/.ai"
  [ -f "$root/.ai/decisions.md" ] && cp "$root/.ai/decisions.md" "$wt/.ai/decisions.md" || true
  [ -f "$root/.ai/implementer.md" ] && cp "$root/.ai/implementer.md" "$wt/.ai/implementer.md" || true

  mkdir -p "$root/.aif"
  local ign
  for ign in ".aif/" ".ai/current-task.md" ".ai/review.json" ".reasonix/"; do
    grep -qsxF "$ign" "$root/.gitignore" 2>/dev/null || echo "$ign" >> "$root/.gitignore"
  done
  python3 - "$(state_file)" "$slug" "$branch" "$wt" "$desc" "$base" <<'PY'
import json, sys
f, slug, branch, wt, desc, base = sys.argv[1:7]
json.dump({"slug": slug, "branch": branch, "worktree": wt,
           "description": desc, "base_branch": base},
          open(f, "w", encoding="utf-8"), ensure_ascii=False, indent=2)
PY
  printf '%s✓ tarefa aberta%s\n' "$grn" "$rst"
  printf '  branch    %s (base: %s)\n' "$branch" "$base"
  printf '  worktree  %s\n\n' "$wt"
  printf '%sPróximo passo:%s abra os dois agentes na worktree e planeje.\n\n' "$bold" "$rst"
  printf '    cd "%s"\n' "$wt"
  printf '    %-15s %s# depois: /planejar %s%s\n' "$ORCH_CMD" "$dim" "$desc" "$rst"
}

cmd_cd() { read_state; printf '%s\n' "$WORKTREE"; }

cmd_status() {
  read_state
  local p r
  p="$(plan_state)"; r="$(review_state)"
  printf '\n%s%s%s  %s\n' "$bold" "$SLUG" "$rst" "$DESCRIPTION"
  printf '%sbranch %s · worktree %s%s\n\n' "$dim" "$BRANCH" "$WORKTREE" "$rst"

  if [ -n "$ACCEPTED" ]; then
    printf '  aceita       %s✓ commitada em %s%s\n' "$grn" "$ACCEPTED" "$rst"
    printf '  integração   %s— pendente%s\n\n' "$ylw" "$rst"
    printf '%s→ próximo passo:%s teste a mudança de verdade e rode %saif land%s\n' \
      "$bold" "$rst" "$bold" "$rst"
    printf '  %s(mescla em %s, remove a worktree, apaga a branch)%s\n\n' "$dim" "$BASE" "$rst"
    return
  fi

  case "$p" in
    ok)      printf '  plano        %s✓ válido%s\n' "$grn" "$rst" ;;
    missing) printf '  plano        %s— ausente%s\n' "$ylw" "$rst" ;;
    *)       printf '  plano        %s✗ %s%s\n' "$red" "${p#invalid:}" "$rst" ;;
  esac
  if has_code_changes; then
    printf '  implementação %s✓ há mudanças de código%s\n' "$grn" "$rst"
  else
    printf '  implementação %s— nada fora de .ai/%s\n' "$ylw" "$rst"
  fi
  case "$r" in
    missing)   printf '  revisão      %s— ausente%s\n' "$ylw" "$rst" ;;
    approved:*) printf '  revisão      %s✓ aprovada (%s LOW)%s\n' "$grn" "${r#approved:}" "$rst" ;;
    changes:*) printf '  revisão      %s✗ mudanças exigidas (%s bloqueante(s))%s\n' "$red" "${r#changes:}" "$rst" ;;
    *)         printf '  revisão      %s✗ %s%s\n' "$red" "${r#invalid:}" "$rst" ;;
  esac

  printf '\n%s→ próximo passo:%s ' "$bold" "$rst"
  if [ "$p" != "ok" ]; then
    printf 'no %s%s%s, dentro da worktree: %s/planejar %s%s\n\n' \
      "$cyn" "$ORCH_NAME" "$rst" "$bold" "$DESCRIPTION" "$rst"
  elif ! has_code_changes; then
    printf 'no %sReasonix%s: cole o bloco /goal que o %s imprimiu.\n\n' \
      "$cyn" "$rst" "$ORCH_NAME"
  elif [ "$r" = "missing" ]; then
    printf 'no %s%s%s: %s/revisar%s\n\n' "$cyn" "$ORCH_NAME" "$rst" "$bold" "$rst"
  else
    case "$r" in
      approved:*) printf 'rode %saif accept%s para commitar.\n\n' "$bold" "$rst" ;;
      changes:*)  printf 'no %sReasonix%s: cole o bloco de correção que o %s imprimiu.\n\n' \
                    "$cyn" "$rst" "$ORCH_NAME" ;;
      *)          printf 'o %s.ai/review.json%s está inválido; peça ao %s para reescrevê-lo.\n\n' \
                    "$bold" "$rst" "$ORCH_NAME" ;;
    esac
  fi
}

cmd_verify() {
  read_state
  local p r; p="$(plan_state)"; r="$(review_state)"
  [ "$p" = "ok" ] || die "plano inválido: ${p#*:}"
  case "$r" in
    missing)    die "não há .ai/review.json — nada a validar" ;;
    invalid:*)  die "review.json inválido: ${r#invalid:}" ;;
    changes:*)  printf '%s✗ mudanças exigidas (%s bloqueante(s))%s\n' "$red" "${r#changes:}" "$rst"; return 1 ;;
    approved:*) printf '%s✓ aprovado (%s observações LOW)%s\n' "$grn" "${r#approved:}" "$rst" ;;
  esac
}

cmd_accept() {
  read_state
  cmd_verify >/dev/null || die "a revisão não aprovou; nada foi commitado"
  has_code_changes || die "nada a commitar: nenhum arquivo mudou fora de .ai/"
  # O plano e o veredito são efêmeros e por worktree. Commitá-los faz a tarefa
  # seguinte nascer com o plano e o `approved` da anterior — e um review.json
  # de outra tarefa abre este mesmo portão por engano. O .reasonix/ é estado
  # local do app do worker (títulos de tópico, timestamps): não pertence ao
  # histórico do projeto, e o worker o escreve dentro da worktree.
  # Nada de ':(exclude)' aqui: um pathspec de exclusão faz o git tratar esses
  # caminhos como nomeados à mão e recusar o add inteiro quando eles estão no
  # .gitignore — que é justamente onde 'aif open' os põe. Adiciona tudo e
  # tira os três do índice depois, o que vale nos dois casos.
  git -C "$WORKTREE" add -A -- .
  git -C "$WORKTREE" reset -q -- .ai/current-task.md .ai/review.json .reasonix
  git -C "$WORKTREE" commit -q -m "$COMMIT_PREFIX: $DESCRIPTION"
  local sha; sha="$(git -C "$WORKTREE" rev-parse --short HEAD)"
  mark_accepted "$sha"
  printf '%s✓ %s commitado em %s%s\n\n' "$grn" "$sha" "$BRANCH" "$rst"

  printf '%s⚠  aceito não é testado.%s A revisão leu o diff; ela não rodou o código.\n' "$ylw" "$rst"
  printf '   Antes de integrar, exercite a mudança de verdade — a suíte de testes e\n'
  printf '   o sistema rodando como roda em produção: mesma configuração, mesmos\n'
  printf '   dados, mesmos serviços externos. Nada disso foi verificado até aqui.\n\n'
  printf '     cd "%s"\n' "$WORKTREE"
  printf '     git diff %s...%s   %s# o que exatamente vai entrar%s\n\n' \
    "$BASE" "$BRANCH" "$dim" "$rst"

  printf '%sQuando estiver convencido:%s  %saif land%s\n' "$bold" "$rst" "$bold" "$rst"
  printf '   %smescla %s em %s, remove a worktree e apaga a branch.%s\n' \
    "$dim" "$BRANCH" "$BASE" "$rst"
  printf '   %spara descartar em vez de integrar: aif drop%s\n\n' "$dim" "$rst"
}

cmd_land() {
  read_state
  [ -n "$ACCEPTED" ] \
    || die "a tarefa '$SLUG' ainda não foi aceita. Rode 'aif accept' primeiro."
  refuse_if_inside "$WORKTREE"

  local root err; root="$(repo_root)"
  # Não exijo árvore limpa: o próprio 'aif open' deixa o .gitignore sujo, e o
  # git já recusa checkout e merge que perderiam trabalho local. Deixo ele
  # julgar e repasso o motivo.
  [ -e "$root/.git/MERGE_HEAD" ] \
    && die "há um merge em andamento em $root; conclua ou aborte antes de integrar"

  local cur; cur="$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ "$cur" != "$BASE" ]; then
    err="$(git -C "$root" checkout "$BASE" 2>&1)" \
      || die "não consegui mudar para $BASE no repositório principal:

$err"
    printf '%s(troquei %s → %s no repositório principal)%s\n' \
      "$dim" "${cur:-HEAD destacado}" "$BASE" "$rst"
  fi

  if ! err="$(git -C "$root" merge --no-edit "$BRANCH" 2>&1)"; then
    # Se conflitou de verdade, desfaz. Se o git recusou antes de mexer em
    # qualquer coisa (mudanças locais no caminho), não há o que desfazer.
    git -C "$root" merge --abort >/dev/null 2>&1 || true
    die "não consegui mesclar $BRANCH em $BASE; nada mudou.

$err

    Se foi conflito, atualize a branch da tarefa primeiro:
      git -C \"$WORKTREE\" rebase $BASE
    resolva os conflitos lá e rode 'aif land' de novo."
  fi
  local sha; sha="$(git -C "$root" rev-parse --short HEAD)"

  git -C "$root" worktree remove --force "$WORKTREE"
  git -C "$root" branch -d "$BRANCH" >/dev/null 2>&1 \
    || printf '%saviso: não consegui apagar %s; apague à mão se quiser%s\n' \
         "$ylw" "$BRANCH" "$rst"
  rmdir "$(dirname "$WORKTREE")" 2>/dev/null || true   # se foi a última tarefa
  rm -f "$(state_file)"

  printf '\n%s✓ %s integrado em %s (%s)%s\n' "$grn" "$BRANCH" "$BASE" "$sha" "$rst"
  printf '  worktree removida · branch apagada\n\n'
  printf '  publicar:  %sgit push origin %s%s\n\n' "$bold" "$BASE" "$rst"
}

cmd_drop() {
  read_state
  refuse_if_inside "$WORKTREE"
  [ -n "$ACCEPTED" ] && printf '%saviso: esta tarefa foi aceita (%s) e o trabalho será perdido.%s\n' \
    "$ylw" "$ACCEPTED" "$rst"
  printf 'remover a worktree %s e a branch %s? [s/N] ' "$WORKTREE" "$BRANCH"
  read -r a; case "$a" in s|S|y|Y) ;; *) echo "cancelado"; return ;; esac
  git -C "$(repo_root)" worktree remove --force "$WORKTREE"
  git -C "$(repo_root)" branch -D "$BRANCH" >/dev/null 2>&1 || true
  rmdir "$(dirname "$WORKTREE")" 2>/dev/null || true   # se foi a última tarefa
  rm -f "$(state_file)"
  printf '%s✓ removidos%s\n' "$grn" "$rst"
}

# ${1+"$@"} e não "$@": o bash 3.2 que vem no macOS trata "$@" como variável
# não definida sob 'set -u' quando não sobrou nenhum parâmetro. Sem o guarda,
# um 'aif install' sem argumento morria com "unbound variable" em vez de
# imprimir o uso. Em bash 4.4+ as duas formas são equivalentes.
case "${1:-status}" in
  install) shift; cmd_install ${1+"$@"} ;;
  open)   shift; cmd_open ${1+"$@"} ;;
  cd)     cmd_cd ;;
  status) cmd_status ;;
  verify) cmd_verify ;;
  accept) cmd_accept ;;
  land)   cmd_land ;;
  drop)   cmd_drop ;;
  version|--version|-V) printf 'aif %s\n' "$AIF_VERSION" ;;
  -h|--help|help)
    printf '%saif %s%s\n\n' "$bold" "$AIF_VERSION" "$rst"
    # Sem sed: o BSD sed do macOS não aceita 'q' no meio de um bloco.
    n=0
    while IFS= read -r l; do
      n=$((n + 1)); [ "$n" -lt 3 ] && continue
      case "$l" in '#'*) l="${l#\#}"; printf '%s\n' "${l# }" ;; *) break ;; esac
    done < "$0" ;;
  *) die "comando desconhecido: $1 (tente: aif --help)" ;;
esac
